LIN 1 sha256-wcrPgr6mZdpNuvWOs0G3rzlCDUySSKASq6NDbvH4Ars
$schema https://json-schema.org/draft/2020-12/schema
$id https://github.com/david-brandt-the-icelander/lean-indented-notation/registries
title LIN schema registries
description Public content-addressed stores of LIN schemas. The schema with hash H is at <prefix>H.lin, and also at <prefix>H.json; a reader hashes whatever it fetches and rejects it if the hash differs.
type object
required[] registries
properties
 registries
  type array
  minItems 1
  items
   type object
   required[] name|prefix
   properties
    name{} type string
    prefix{} type string|pattern ^https://[^ ]*/$
    description{} type string
   additionalProperties false
additionalProperties false
