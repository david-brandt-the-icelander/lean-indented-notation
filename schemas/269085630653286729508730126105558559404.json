{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/david-brandt-the-icelander/lean-indented-notation/registry-index",
  "title": "LIN schema registry index",
  "description": "The schemas a registry holds. A registered number is assigned once, by the official registry, and never changes or is reused; a provisional id already listed with other content is refused.",
  "type": "object",
  "required": [
    "schemas"
  ],
  "additionalProperties": false,
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "provisional",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 999999999
          },
          "provisional": {
            "type": "string",
            "pattern": "^[0-9]{39}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
