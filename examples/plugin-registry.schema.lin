LIN 1 sha256-wcrPgr6mZdpNuvWOs0G3rzlCDUySSKASq6NDbvH4Ars
$schema https://json-schema.org/draft/2020-12/schema
title Plugin registry
type object
required[] name|plugins
properties
 name{} type string
 version{} type string
 description{} type string
 plugins
  type array
  items
   type object
   required[] id|title
   properties
    id{} type string|pattern ^[a-z0-9-]+$
    title{} type string
    enabled{} type boolean
    priority
     type[] integer|string
    summary{} type string
    notes{} type string
    tags
     type array
     items{} type string
    sources
     type array
     items
      type object
      properties
       path{} type string
       lines{} type integer
